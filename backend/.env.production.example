# ==============================================================================
# Edu Wire Team Tracker — Production Environment Variables Template
# ==============================================================================

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Atlas Primary Cluster Connection
# Note: Use a dedicated production database user with least-privilege readWrite access
MONGODB_URI=mongodb+srv://<prod_db_user>:<prod_db_password>@cluster0.xxxxx.mongodb.net/edu_wire_tracker_prod?retryWrites=true&w=majority

# JWT Authentication Secrets (Must be 32+ characters cryptographically random strings)
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_key_here
JWT_REFRESH_SECRET=replace_with_64_character_cryptographically_secure_refresh_key_here

# Frontend Host URL for Restricted CORS & Cookie Domain
FRONTEND_URL=https://tracker.eduwire.com

# Redis Connection for BullMQ Background Queues
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_auth_password_here
# Alternative connection URL format (if using managed Redis like Upstash or AWS ElastiCache):
# REDIS_URL=rediss://default:<password>@<host>:<port>

# Flags
USE_MOCK_REDIS=false
USE_MOCK_WHATSAPP=false

# Expo Push Notifications (Optional access token for enhanced throughput)
EXPO_ACCESS_TOKEN=

# WhatsApp Business Cloud API (For Senior Developer Handoff)
WHATSAPP_API_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_verify_token

