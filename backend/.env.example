NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Redis & Background Jobs (Upstash – TLS enabled, use rediss:// with two s's)
# For a local Redis instance without TLS use: redis://127.0.0.1:6379
# For Upstash (TLS required) use:            rediss://default:YOUR_PASSWORD@your-host.upstash.io:6379
REDIS_URL=rediss://default:QAAAAAAAvH1AAIgcDIwYzI4NzEyZTA4OWI0MTRiODBlZDc3MDIwMmYxMzA1YQ@your-upstash-host.upstash.io:6379
# Host/port are only used as fallback when REDIS_URL is not set
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
USE_MOCK_REDIS=false


